{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Party Anywhere",
  "version": "0.1.0",
  "identifier": "dev.partyanywhere.hub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Party Anywhere",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Central de controles para jogos co-op locais",
    "longDescription": "Controles, celulares e teclados viram jogadores P1..P10. Biblioteca de jogos co-op por link.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
