{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Party Anywhere",
  "version": "0.1.3",
  "identifier": "dev.partyanywhere.hub",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Party Anywhere",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Central de controles para jogos co-op locais",
    "longDescription": "Controles, celulares e teclados viram jogadores P1..P10. Biblioteca de jogos co-op por link.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  }
}
