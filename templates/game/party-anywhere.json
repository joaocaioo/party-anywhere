{
  "$schema": "https://raw.githubusercontent.com/joaocaioo/party-anywhere/main/schema/game-manifest.v1.json",
  "manifestVersion": 1,
  "id": "com.seu-usuario.meu-jogo",
  "name": "Meu Jogo",
  "tagline": "Uma frase curta que vende o jogo.",
  "description": "README.md",
  "authors": ["seu-usuario"],
  "license": "MIT",
  "version": "0.1.0",
  "art": {
    "cover": "assets/cover.png"
  },
  "players": { "min": 1, "max": 10, "recommended": 4 },
  "sdk": { "abi": 1 },
  "tags": [],
  "install": {
    "source": "github-release",
    "asset": "meu-jogo-{version}.zip",
    "target": "self",
    "files": [{ "from": "MeuJogo.exe", "to": "MeuJogo.exe" }]
  },
  "launch": {
    "exe": "MeuJogo.exe",
    "args": [],
    "workingDir": "."
  },
  "controls": {
    "modes": [
      {
        "name": "Jogar",
        "pieces": [
          { "kind": "START", "x": 0.074, "y": 0.12, "s": 0.9, "label": "Pausa" },
          { "kind": "LB", "x": 0.184, "y": 0.27, "label": "Correr" },
          { "kind": "stickL", "x": 0.184, "y": 0.66, "label": "Andar" },
          { "kind": "RT", "x": 0.848, "y": 0.12, "label": "Atirar" },
          { "kind": "Y", "x": 0.848, "y": 0.4 },
          { "kind": "X", "x": 0.747, "y": 0.6, "label": "Usar" },
          { "kind": "B", "x": 0.949, "y": 0.6 },
          { "kind": "A", "x": 0.848, "y": 0.82, "s": 1.1, "label": "Pular" },
          { "kind": "stickR", "x": 0.668, "y": 0.84, "s": 0.7, "label": "Olhar" }
        ]
      }
    ]
  }
}
